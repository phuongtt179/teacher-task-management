# Chạy thử trên máy với Firebase Emulator — npm run dev:emulator (xem scripts/emulator/README.md).
# Dự án giả "demo-…" không bao giờ chạm tới Firebase thật.
VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-ttm
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_STORAGE_BUCKET=demo-ttm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_API_URL=http://localhost:3001/api
